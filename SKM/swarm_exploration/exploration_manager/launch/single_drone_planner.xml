<launch>
  <arg name="map_size_x"/>
  <arg name="map_size_y"/>
  <arg name="map_size_z"/>
  <arg name="drone_id"/>
  <arg name="drone_num"/>

  <arg name="odometry_topic"/>
  <arg name="sensor_pose_topic"/>
  <arg name="depth_topic"/>
  <arg name="cloud_topic"/>

  <arg name="cx"/>
  <arg name="cy"/>
  <arg name="fx"/>
  <arg name="fy"/>
  <arg name="max_vel"/>
  <arg name="max_acc"/>
  <arg name="simulation" default="true"/>
  <arg name="single_expo" default="false"/>

  <!-- 负载均衡(与队友一致: launch 传参, 默认 MINSUM/0.75) -->
  <arg name="mtsp_objective" default="MINSUM"/>
  <arg name="capacity_factor" default="0.75"/>

  <!-- main node -->
  <node pkg="exploration_manager" name="exploration_node_$(arg drone_id)" type="exploration_node" output="log">
    <remap from ="/odom_world" to="$(arg odometry_topic)"/>
    <remap from ="/map_ros/pose"   to = "$(arg sensor_pose_topic)"/> 
    <remap from ="/map_ros/depth" to = "$(arg depth_topic)"/>
    <remap from ="/map_ros/cloud" to="$(arg cloud_topic)"/>

    <remap from="/planning/replan" to="/planning/replan_$(arg drone_id)" />
    <remap from="/planning/new" to="/planning/new_$(arg drone_id)" />
    <remap from="/planning/bspline" to="/planning/bspline_$(arg drone_id)" />

    <remap from="/swarm_expl/drone_state_send" to="/swarm_expl/drone_state" />
    <remap from="/swarm_expl/drone_state_recv" to="/swarm_expl/drone_state" />
    <remap from="/swarm_expl/pair_opt_send" to="/swarm_expl/pair_opt" />
    <remap from="/swarm_expl/pair_opt_recv" to="/swarm_expl/pair_opt" />
    <remap from="/swarm_expl/pair_opt_res_send" to="/swarm_expl/pair_opt_res" />
    <remap from="/swarm_expl/pair_opt_res_recv" to="/swarm_expl/pair_opt_res" />
    <remap from="/swarm_expl/grid_tour_send" to="/swarm_expl/grid_tour" />
    <remap from="/swarm_expl/hgrid_send" to="/swarm_expl/hgrid" />
    <remap from="/multi_map_manager/chunk_stamps_send" to="/multi_map_manager/chunk_stamps" />
    <remap from="/multi_map_manager/chunk_data_send" to="/multi_map_manager/chunk_data" />
    <remap from="/multi_map_manager/chunk_stamps_recv" to="/multi_map_manager/chunk_stamps" />
    <remap from="/multi_map_manager/chunk_data_recv" to="/multi_map_manager/chunk_data" />
    <remap from="/planning/swarm_traj_recv" to="/planning/swarm_traj" />
    <remap from="/planning/swarm_traj_send" to="/planning/swarm_traj" />

    <remap from="/planning_vis/trajectory" to="/planning_vis/trajectory_$(arg drone_id)" />
    <remap from="/planning_vis/frontier" to="/planning_vis/frontier_$(arg drone_id)" />
    <remap from="/planning_vis/viewpoints" to="/planning_vis/viewpoints_$(arg drone_id)" />

    <remap from="/sdf_map/occupancy_all" to="/sdf_map/occupancy_all_$(arg drone_id)" />
    <remap from="/sdf_map/occupancy_local" to="/sdf_map/occupancy_local_$(arg drone_id)" />
    <remap from="/sdf_map/occupancy_local_inflate" to="/sdf_map/occupancy_local_inflate_$(arg drone_id)" />
    <remap from="/sdf_map/unknown" to="/sdf_map/unknown_$(arg drone_id)" />
    <remap from="/sdf_map/update_range" to="/sdf_map/update_range_$(arg drone_id)" />
    <remap from="/sdf_map/basecoor" to="/swarm_sim_tf/basecoor_$(arg drone_id)" if="$(eval arg('simulation') == 'light')"/>
    <remap from="/sdf_map/basecoor" to="/pcl_render_node/init" if="$(eval arg('simulation') == 'px4')"/>
    <remap from="/sdf_map/basecoor" to="/swarm_drones/swarm_drone_basecoor" if="$(eval arg('simulation') == 'false' or arg('simulation') == 'full')"/>
    

    <param name="sdf_map/resolution"      value="0.05" /> 
    <param name="sdf_map/map_size_x"   value="$(arg map_size_x)" /> 
    <param name="sdf_map/map_size_y"   value="$(arg map_size_y)" /> 
    <param name="sdf_map/map_size_z"   value="$(arg map_size_z)" /> 
    <param name="sdf_map/obstacles_inflation"     value="0.35" /> 
    <!-- <param name="sdf_map/obstacles_inflation"     value="0.0" />  -->
    <param name="sdf_map/local_bound_inflate"    value="0.5"/>
    <param name="sdf_map/local_map_margin" value="50"/>
    <param name="sdf_map/ground_height"        value="1.15"/>
    <param name="sdf_map/default_dist"        value="0.5"/>
    
    <param name="sdf_map/p_hit"  value="0.65"/>
    <param name="sdf_map/p_miss" value="0.35"/>
    <param name="sdf_map/p_min"  value="0.12"/>
    <param name="sdf_map/p_max"  value="0.90"/>
    <param name="sdf_map/p_occ"  value="0.80"/>
    <param name="sdf_map/min_ray_length" value="0.5"/>
    <param name="sdf_map/max_ray_length" value="4.5"/>
    <param name="sdf_map/virtual_ceil_height"   value="1.8"/>
    <param name="sdf_map/optimistic" value="true" type="bool"/>
    <param name="sdf_map/signed_dist" value="false" type="bool"/>
    <!-- <param name="sdf_map/box_min_x" value="-4" type="double"/>
    <param name="sdf_map/box_min_y" value="-7" type="double"/>
    <param name="sdf_map/box_min_z" value="0.0" type="double"/>
    <param name="sdf_map/box_max_x" value="4" type="double"/>
    <param name="sdf_map/box_max_y" value="7" type="double"/>
    <param name="sdf_map/box_max_z" value="2.0" type="double"/> -->
    <param name="sdf_map/box_min_x" value="-14.5" type="double"/><!-- 30x30 pcd_generated, 墙在±15, 留0.5m余量 -->
    <param name="sdf_map/box_min_y" value="-14.5" type="double"/>
    <param name="sdf_map/box_min_z" value="1.15" type="double"/>
    <param name="sdf_map/box_max_x" value="14.5" type="double"/>
    <param name="sdf_map/box_max_y" value="14.5" type="double"/>
    <param name="sdf_map/box_max_z" value="1.8" type="double"/>
    <param name="sdf_map/no_drone_1" value="false" type="bool"/>

    <param name="map_ros/cx" value="$(arg cx)"/>
    <param name="map_ros/cy" value="$(arg cy)"/>
    <param name="map_ros/fx" value="$(arg fx)"/>
    <param name="map_ros/fy" value="$(arg fy)"/>
    <param name="map_ros/depth_filter_maxdist"   value="4.6"/>
    <param name="map_ros/depth_filter_mindist"   value="0.2"/>
    <param name="map_ros/depth_filter_margin"    value="2"/>
    <param name="map_ros/k_depth_scaling_factor" value="1000.0"/>
    <param name="map_ros/skip_pixel" value="2"/>
    <param name="map_ros/esdf_slice_height" value="0.5"/>
    <param name="map_ros/visualization_truncate_height"   value="10.09"/>
    <param name="map_ros/visualization_truncate_low"   value="-2.0"/>
    <param name="map_ros/show_occ_time"  value="false"/>
    <param name="map_ros/show_esdf_time" value="false"/>
    <param name="map_ros/show_all_map" value="true"/>
    <param name="map_ros/frame_id"      value="world"/>

    <!-- Fsm -->
    <param name="fsm/thresh_replan1" value="0.5" type="double"/>
    <param name="fsm/thresh_replan2" value="0.2" type="double"/>
    <param name="fsm/thresh_replan3" value="1.8" type="double"/>
    <!-- <param name="fsm/thresh_replan1" value="0.00001" type="double"/> -->
    <!-- <param name="fsm/thresh_replan2" value="100.0" type="double"/> -->
    <!-- <param name="fsm/thresh_replan3" value="0.1" type="double"/> -->
    <param name="fsm/replan_time" value="0.28" type="double"/>
    <!-- T1S1 FSM stagnation recovery; disabled unless runner sets enabled=true. -->
    <param name="fsm/stagnation_recovery_enabled" value="false" type="bool"/>
    <param name="fsm/stagnation_window" value="20.0" type="double"/>
    <param name="fsm/stagnation_displacement" value="0.8" type="double"/>
    <param name="fsm/stagnation_speed" value="0.12" type="double"/>
    <param name="fsm/stagnation_cooldown" value="35.0" type="double"/>
    <param name="fsm/stagnation_max_recoveries" value="2" type="int"/>
    <!-- T1S2A FSM sliding stagnation recovery; disabled unless runner sets enabled=true. -->
    <param name="fsm/sliding_recovery_enabled" value="false" type="bool"/>
    <param name="fsm/sliding_recovery_window" value="15.0" type="double"/>
    <param name="fsm/sliding_recovery_displacement" value="1.0" type="double"/>
    <param name="fsm/sliding_recovery_mean_speed" value="0.20" type="double"/>
    <param name="fsm/sliding_recovery_cooldown" value="45.0" type="double"/>
    <param name="fsm/sliding_recovery_max_count" value="2" type="int"/>
    <param name="fsm/sliding_recovery_current_speed" value="0.25" type="double"/>
    <param name="fsm/sliding_recovery_good_evals_required" value="3" type="int"/>
    <param name="fsm/sync_interval" value="0.200" type="double"/>
    <param name="fsm/wait_delete_duration" value="0.05" type="double"/>
    <param name="fsm/gain_thresh" value="10" type="int"/>

    <param name="fsm/attempt_interval" value="0.1" type="double"/>
    <param name="fsm/pair_opt_interval" value="0.5" type="double"/>

    <!-- 20% 丢包鲁棒性: 对称生效协议参数 + 丢包模拟(仅测试用) -->
    <param name="fsm/opt_retry_interval" value="0.2" type="double"/>
    <param name="fsm/opt_timeout" value="1.5" type="double"/>
    <param name="fsm/sim_drop_rate" value="0.0" type="double"/>

    <param name="partitioning/min_unknown" value="4000" type="int"/>;
    <param name="partitioning/min_frontier" value="100" type="int"/>;
    <param name="partitioning/min_free" value="3000" type="int"/>;
    <param name="partitioning/consistent_cost" value="-5" type="double"/>;
    <param name="partitioning/consistent_cost2" value="8" type="double"/>;
    <param name="partitioning/w_unknown" value="0.0" type="double"/>;
    <param name="partitioning/grid_size" value="5.0" type="double"/>;
    <param name="partitioning/use_swarm_tf" value="false" type="bool"/>;

    <!-- Exploration manager -->

    <param name="exploration/refine_local" value="true" type="bool"/>
    <param name="exploration/mtsp_objective" value="$(arg mtsp_objective)" type="string"/>
    <param name="exploration/capacity_factor" value="$(arg capacity_factor)" type="double"/>
    <param name="exploration/refined_num" value="4" type="int"/>
    <param name="exploration/refined_radius" value="6.0" type="double"/>
    <param name="exploration/max_decay" value="0.82" type="double"/>
    <param name="exploration/top_view_num" value="16" type="int"/>
    <param name="exploration/vm" value="$(eval 1.0 * arg('max_vel'))" type="double"/>
    <param name="exploration/am" value="$(eval 1.0 * arg('max_acc'))" type="double"/>
    <param name="exploration/yd" value="$(eval 80 * 3.1415926 / 180.0)" type="double"/>
    <!-- <param name="exploration/yd" value="$(eval 60 * 3.1415926 / 180.0)" type="double"/> -->
    <param name="exploration/ydd" value="$(eval 90 * 3.1415926 / 180.0)" type="double"/>
    <param name="exploration/w_dir" value="1.5" type="double"/>
    <param name="exploration/tsp_dir" value="$(find lkh_tsp_solver)/resource" type="string"/>
    <param name="exploration/mtsp_dir" value="$(find lkh_mtsp_solver)/resource" type="string"/>
    <param name="exploration/drone_num" value="$(arg drone_num)" type="double"/>
    <param name="exploration/drone_id" value="$(arg drone_id)" type="int"/>
    <param name="exploration/init_plan_num" value="2" type="int"/>

    <!-- S3F failure-viewpoint memory. Baseline runs record events with enforcement disabled. -->
    <param name="failure_memory/enabled" value="true" type="bool"/>
    <param name="failure_memory/enforce" value="true" type="bool"/>
    <param name="failure_memory/enforce_low_speed_only" value="true" type="bool"/>
    <param name="failure_memory/hard_prune" value="false" type="bool"/>
    <param name="failure_memory/shadow" value="false" type="bool"/>
    <param name="failure_memory/local_enforce" value="true" type="bool"/>
    <param name="failure_memory/frontier_soft_enforce" value="true" type="bool"/>
    <param name="failure_memory/frontier_max_fraction" value="0.67" type="double"/>
    <param name="failure_memory/frontier_penalty_ratio" value="0.25" type="double"/>
    <param name="failure_memory/region_size_m" value="4.8" type="double"/>
    <param name="failure_memory/cooldown_sec" value="90.0" type="double"/>
    <param name="failure_memory/blacklist_threshold" value="1" type="int"/>
    <param name="failure_memory/blacklist_sec" value="120.0" type="double"/>
    <param name="failure_memory/forget_sec" value="180.0" type="double"/>
    <param name="failure_memory/cost_penalty" value="3.0" type="double"/>
    <param name="failure_memory/kino_scale" value="0.0" type="double"/>
    <param name="failure_memory/clearance_protect_m" value="0.8" type="double"/>
    <param name="failure_memory/protected_scale" value="0.25" type="double"/>
    <param name="failure_memory/approach_cos" value="0.5" type="double"/>

    <!-- T1S4 planner shadow/fusion; disabled unless runner enables them. -->
    <param name="planner_escape/shadow" value="true" type="bool"/>
    <param name="planner_escape/enabled" value="true" type="bool"/>
    <param name="planner_escape/fusion_enabled" value="true" type="bool"/>
    <param name="planner_escape/idle_enabled" value="false" type="bool"/>
    <param name="planner_escape/idle_window_sec" value="30.0" type="double"/>
    <param name="planner_escape/idle_net_threshold" value="22" type="double"/>
    <param name="planner_escape/idle_skip_sec" value="40.0" type="double"/>
    <param name="planner_escape/fusion_match_mode" value="legacy" type="string"/>
    <param name="planner_escape/fusion_match_window_sec" value="30.0" type="double"/>
    <param name="planner_escape/require_low_motion" value="false" type="bool"/>
    <param name="planner_escape/trigger_mode" value="low_speed_escape" type="string"/>
    <param name="planner_escape/startup_guard_sec" value="40.0" type="double"/>
    <param name="planner_escape/low_speed_topic" value="/planning/low_speed_escape_$(arg drone_id)" type="string"/>
    <param name="planner_escape/consecutive_fail_threshold" value="5" type="int"/>
    <param name="planner_escape/repeat_fraction_threshold" value="0.28" type="double"/>
    <param name="planner_escape/max_escape_count" value="12" type="int"/>
    <param name="planner_escape/cooldown_sec" value="35" type="double"/>
    <param name="planner_escape/urgent_cooldown_sec" value="15" type="double"/>
    <param name="planner_escape/fail_window_sec" value="12.0" type="double"/>
    <param name="planner_escape/repeat_frontier_soft_enforce" value="true" type="bool"/>
    <param name="planner_escape/repeat_frontier_threshold" value="12" type="int"/>
    <param name="planner_escape/repeat_frontier_strong_threshold" value="16" type="int"/>
    <param name="planner_escape/repeat_frontier_penalty_ratio" value="0.15" type="double"/>
    <param name="planner_escape/repeat_frontier_max_fraction" value="0.67" type="double"/>
    <param name="planner_escape/repeat_frontier_low_gain_threshold" value="2.0" type="double"/>
    <param name="planner_escape/repeat_frontier_cooldown_sec" value="35" type="double"/>
    <param name="planner_escape/repeat_frontier_max_penalty_ratio" value="0.30" type="double"/>
    <param name="planner_escape/gain_rank_enforce" value="true" type="bool"/>
    <param name="planner_escape/gain_rank_gain_weight" value="0.06" type="double"/>
    <param name="planner_escape/gain_rank_gain_cap" value="20.0" type="double"/>
    <param name="planner_escape/gain_rank_bonus_ratio" value="0.18" type="double"/>
    <param name="planner_escape/gain_rank_low_gain_threshold" value="2.0" type="double"/>
    <param name="planner_escape/gain_rank_low_gain_penalty_ratio" value="0.08" type="double"/>
    <param name="planner_escape/gain_rank_max_fraction" value="0.75" type="double"/>
    <param name="planner_escape/cluster_suppress_sec" value="60" type="double"/>
    <param name="planner_escape/topology_bonus" value="0.30" type="double"/>
    <param name="planner_escape/cluster_radius_m" value="4.5" type="double"/>
    <param name="planner_escape/v2_enabled" value="true" type="bool"/>
    <param name="planner_escape/v2_clear_radius_m" value="5.5" type="double"/>
    <param name="planner_escape/v2_min_step_m" value="2.5" type="double"/>
    <param name="planner_escape/v2_max_step_m" value="5.0" type="double"/>
    <param name="planner_escape/v2_ttl_sec" value="45.0" type="double"/>
    <param name="planner_escape/v2_min_clearance_m" value="0.55" type="double"/>
    <param name="planner_escape/v2_memory_ttl_sec" value="180.0" type="double"/>
    <param name="planner_escape/v2_max_cost" value="2500.0" type="double"/>
    <param name="planner_escape/v2_fallback_enabled" value="true" type="bool"/>
    <param name="planner_escape/v2_trigger_on_planner_fail" value="true" type="bool"/>
    <param name="planner_escape/v2_target_repeat_threshold" value="8" type="int"/>
    <param name="planner_escape/v2_sticky_center" value="true" type="bool"/>
    <param name="planner_escape/v2_failed_target_memory" value="true" type="bool"/>
    <param name="planner_escape/v2_failed_target_radius_m" value="0.8" type="double"/>
    <param name="planner_escape/v2_boundary_guard_enabled" value="false" type="bool"/>
    <param name="planner_escape/v2_boundary_margin_xy_m" value="0.35" type="double"/>
    <param name="planner_escape/v2_postplan_guard_enabled" value="true" type="bool"/>
    <param name="planner_escape/v2_postplan_dt_sec" value="0.05" type="double"/>
    <param name="planner_escape/v2_progress_guard_enabled" value="false" type="bool"/>
    <param name="planner_escape/v2_progress_horizon_sec" value="1.6" type="double"/>
    <param name="planner_escape/v2_min_progress_xy_m" value="0.25" type="double"/>
    <param name="trajectory_safety/global_postplan_guard_enabled" value="false" type="bool"/>
    <param name="trajectory_safety/reject_unknown" value="false" type="bool"/>
    <param name="trajectory_safety/boundary_margin_xy_m" value="0.50" type="double"/>
    <param name="trajectory_safety/extra_clearance_m" value="0.10" type="double"/>
    <param name="trajectory_safety/dt_sec" value="0.05" type="double"/>

    <param name="frontier/cluster_min" value="90" type="int"/>
    <param name="frontier/cluster_size_xy" value="2.5" type="double"/>
    <param name="frontier/cluster_size_z" value="10.0" type="double"/>
    <param name="frontier/min_candidate_dist" value="0.7" type="double"/>
    <param name="frontier/min_candidate_clearance" value="0.40" type="double"/>
    <param name="frontier/candidate_dphi" value="0.2617993878" type="double"/>
    <param name="frontier/candidate_rnum" value="6" type="int"/>
    <param name="frontier/candidate_rmin" value="1.0" type="double"/>
    <param name="frontier/candidate_rmax" value="2.2" type="double"/>
    <param name="frontier/down_sample" value="3" type="int"/>;
    <param name="frontier/min_visib_num" value="30" type="int"/>;
    <param name="frontier/min_view_finish_fraction" value="0.46" type="double"/>;


    <!-- Perception utils -->
    <param name="perception_utils/top_angle" value="0.56125" type="double"/>;
    <param name="perception_utils/left_angle" value="0.69222" type="double"/>;
    <param name="perception_utils/right_angle" value="0.68901" type="double"/>;
    <param name="perception_utils/max_dist" value="4.5" type="double"/>;
    <param name="perception_utils/vis_dist" value="1.0" type="double"/>;


    <param name="heading_planner/yaw_diff" value="$(eval 30 * 3.1415926 / 180.0)" type="double"/>
    <param name="heading_planner/half_vert_num" value="5" type="int"/>
    <param name="heading_planner/lambda1" value="2.0" type="double"/>
    <param name="heading_planner/lambda2" value="1.0" type="double"/>
    <param name="heading_planner/max_yaw_rate" value="0.6108652382" type="double"/>
    <param name="heading_planner/w" value="20000.0" type="double"/>
    <param name="heading_planner/weight_type" value="1" type="double"/>

  <!-- planner manager -->
    <!-- <param name="manager/max_vel" value="$(arg max_vel)" type="double"/> -->
    <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="manager/max_jerk" value="4" type="double"/>
    <param name="manager/dynamic_environment" value="0" type="int"/>
    <param name="manager/local_segment_length" value="6.0" type="double"/>
    <param name="manager/clearance_threshold" value="0.35" type="double"/>
    <param name="manager/control_points_distance" value="0.5" type="double"/>
    <param name="manager/use_geometric_path" value="true" type="bool"/>
    <param name="manager/use_kinodynamic_path" value="true" type="bool"/>
    <param name="manager/use_topo_path" value="false" type="bool"/>
    <param name="manager/use_optimization" value="true" type="bool"/>
    <param name="manager/use_active_perception" value="true" type="bool"/>
    <param name="manager/min_time" value="true" type="bool"/>
    <param name="manager/relax_time1" value="0.3" type="double"/>
    <param name="manager/relax_time2" value="1.5" type="double"/>
    <param name="manager/max_yawdot" value="$(eval 120 * 3.1415926 / 180.0)" type="double"/>

  <!-- kinodynamic path searching -->
    <param name="search/max_tau" value="0.8" type="double"/>
    <param name="search/init_max_tau" value="1.0" type="double"/>
    <param name="search/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="search/vel_margin" value="0.25" type="double"/>
    <param name="search/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="search/w_time" value="10.0" type="double"/>
    <param name="search/horizon" value="5.5" type="double"/>
    <param name="search/lambda_heu" value="12.0" type="double"/>
    <param name="search/resolution_astar" value="0.025" type="double"/>
    <param name="search/time_resolution" value="0.8" type="double"/>
    <param name="search/margin" value="0.35" type="double"/>
    <param name="search/allocate_num" value="100000" type="int"/>
    <param name="search/check_num" value="10" type="int"/>
    <param name="search/optimistic" value="false" type="bool"/>

    <param name="astar/lambda_heu" value="10000.0" type="double"/>
    <param name="astar/resolution_astar" value="0.3" type="double"/>
    <param name="astar/allocate_num" value="1000000" type="int"/>
    <param name="astar/max_search_time" value="0.001" type="double"/>

  <!-- trajectory optimization -->
    <param name="optimization/ld_smooth" value="5.0" type="double"/>
