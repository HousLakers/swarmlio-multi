<?xml version="1.0"?>
<sdf version="1.6">
  <world name="two_uav_outdoor_50x50_v1">
    <gravity>0 0 -9.8066</gravity>
    <physics name="ode_1000hz" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.55 0.60 0.65 1</ambient>
      <background>0.70 0.82 0.95 1</background>
      <shadows>true</shadows>
      <sky><clouds><speed>0.2</speed></clouds></sky>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- 50 m x 50 m grass/concrete test pad. -->
    <model name="ground_50x50">
      <static>true</static>
      <link name="ground_link">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="ground_collision">
          <geometry><box><size>50 50 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><box><size>50 50 0.1</size></box></geometry>
          <material>
            <ambient>0.22 0.34 0.20 1</ambient>
            <diffuse>0.30 0.46 0.27 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Closed 3 m perimeter; inner faces lie at +/-24.5 m. -->
    <model name="boundary_west"><static>true</static><pose>-24.75 0 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.5 50 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 50 3</size></box></geometry><material><diffuse>0.55 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="boundary_east"><static>true</static><pose>24.75 0 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.5 50 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 50 3</size></box></geometry><material><diffuse>0.55 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="boundary_south"><static>true</static><pose>0 -24.75 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>49 0.5 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>49 0.5 3</size></box></geometry><material><diffuse>0.55 0.58 0.60 1</diffuse></material></visual></link></model>
    <model name="boundary_north"><static>true</static><pose>0 24.75 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>49 0.5 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>49 0.5 3</size></box></geometry><material><diffuse>0.55 0.58 0.60 1</diffuse></material></visual></link></model>

    <!-- Four building-like blocks leave broad exterior lanes. -->
    <model name="building_sw"><static>true</static><pose>-15 -14 2.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>8 6 4</size></box></geometry></collision><visual name="visual"><geometry><box><size>8 6 4</size></box></geometry><material><diffuse>0.55 0.32 0.22 1</diffuse></material></visual></link></model>
    <model name="building_se"><static>true</static><pose>14 -14 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>7 8 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>7 8 5</size></box></geometry><material><diffuse>0.45 0.48 0.52 1</diffuse></material></visual></link></model>
    <model name="building_nw"><static>true</static><pose>-15 14 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>7 8 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>7 8 5</size></box></geometry><material><diffuse>0.46 0.43 0.35 1</diffuse></material></visual></link></model>
    <model name="building_ne"><static>true</static><pose>15 14 2.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>8 6 4</size></box></geometry></collision><visual name="visual"><geometry><box><size>8 6 4</size></box></geometry><material><diffuse>0.38 0.48 0.43 1</diffuse></material></visual></link></model>

    <!-- Split walls create gates and force cooperative route allocation. -->
    <model name="wall_west_upper"><static>true</static><pose>-7 7.5 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 9 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 9 3</size></box></geometry><material><diffuse>0.70 0.67 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_west_lower"><static>true</static><pose>-7 -7.5 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 9 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 9 3</size></box></geometry><material><diffuse>0.70 0.67 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_east_upper"><static>true</static><pose>7 7.5 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 9 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 9 3</size></box></geometry><material><diffuse>0.70 0.67 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_east_lower"><static>true</static><pose>7 -7.5 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 9 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 9 3</size></box></geometry><material><diffuse>0.70 0.67 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_north_left"><static>true</static><pose>-9 7 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 0.4 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 0.4 3</size></box></geometry><material><diffuse>0.70 0.67 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_north_right"><static>true</static><pose>9 7 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 0.4 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 0.4 3</size></box></geometry><material><diffuse>0.70 0.67 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_south_left"><static>true</static><pose>-9 -7 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 0.4 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 0.4 3</size></box></geometry><material><diffuse>0.70 0.67 0.58 1</diffuse></material></visual></link></model>
    <model name="wall_south_right"><static>true</static><pose>9 -7 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 0.4 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 0.4 3</size></box></geometry><material><diffuse>0.70 0.67 0.58 1</diffuse></material></visual></link></model>

    <!-- Scattered columns exercise near-field avoidance without blocking gates. -->
    <model name="column_w1"><static>true</static><pose>-20 -3 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry><material><diffuse>0.75 0.60 0.20 1</diffuse></material></visual></link></model>
    <model name="column_w2"><static>true</static><pose>-19 5 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry><material><diffuse>0.75 0.60 0.20 1</diffuse></material></visual></link></model>
    <model name="column_e1"><static>true</static><pose>20 -4 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry><material><diffuse>0.75 0.60 0.20 1</diffuse></material></visual></link></model>
    <model name="column_e2"><static>true</static><pose>19 5 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry><material><diffuse>0.75 0.60 0.20 1</diffuse></material></visual></link></model>
  </world>
</sdf>
